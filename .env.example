# Haystack AI Service Environment Configuration
# Copy this to .env and update with your values

OPENAI_API_KEY=your_openai_api_key_here

# Durable previous-session summary routing only. Omit or use direct_openai to
# preserve the existing direct OpenAI path and gpt-5.4-mini model.
HAYSTACK_LLM_ROUTE_PREVIOUS_SESSION_SUMMARY=direct_openai
# Required only when the selected route starts with litellm_. The virtual key
# must be dedicated to Haystack; never copy the API service's gateway key here.
LLM_GATEWAY_BASE_URL=
HAYSTACK_LLM_GATEWAY_API_KEY=
HAYSTACK_LITELLM_MODEL_PREVIOUS_SESSION_SUMMARY_OPENAI=antsa-haystack-previous-session-summary-openai
HAYSTACK_LITELLM_MODEL_PREVIOUS_SESSION_SUMMARY_FOUNDRY=antsa-haystack-previous-session-summary-foundry

NESTJS_API_URL=http://localhost:8080  # NestJS API base URL — used for all tool callbacks and API requests
REDIS_URL=redis://localhost:6379
LOG_LEVEL=INFO

# SCALING CONFIGURATION - SUPPORTS THOUSANDS OF USERS
MAX_REQUESTS_PER_USER=10          # Concurrent requests per individual user
MAX_CONCURRENT_REQUESTS=10000     # Theoretical maximum (users * requests_per_user)
SESSION_TIMEOUT_MINUTES=30
HOST=0.0.0.0
PORT=8001

SHOW_TOOL_BANNER=true
SHOW_RAW_TOOL_JSON=false

# Optional: Database connection for web assistant context
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

# Production High-Scale Settings
# MAX_REQUESTS_PER_USER=20         # Allow more concurrent requests per user
# SESSION_TIMEOUT_MINUTES=60       # Longer sessions for better UX
# LOG_LEVEL=WARNING                # Reduce logging overhead

# Load Balancer Settings (for multiple instances)
# INSTANCE_ID=1                    # Unique ID for each instance
# HEALTH_CHECK_INTERVAL=30         # Health check frequency
